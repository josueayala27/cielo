    "@hookform/resolvers": "^7.0.5",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@pandacss/dev": "^2.5.0",
    "@pandacss/preset-base": "^2.5.0",
    "@pandacss/preset-panda": "^2.5.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.158.0"
