{
  "name": "@cielo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SupportDesk web app: Next.js on Cloudflare Workers (OpenNext), styled with Panda CSS.",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
