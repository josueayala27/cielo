{
  "name": "@cielo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SupportDesk REST API: Hono on Cloudflare Workers with D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=seed/seed.sql"
  },
  "dependencies": {
    "@cielo/contracts": "workspace:*",
    "hono": "^4.10.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251106.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.158.0"
  }
}
